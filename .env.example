# Copie pra .env (sem ".example") e edite ambas as variáveis:
#
# 1. IURIA_SCRAPER_TOKEN: gere com `openssl rand -hex 32` na VPS
#    Esse token será adicionado também no Supabase como secret pra
#    a edge function buscar-jurisprudencia chamar a VPS autenticada.
#
# 2. DOMAIN: subdomínio próprio pro scraper (ex: scraper.iuria.com.br)
#    Aponte o A record do DNS pra IP da VPS antes de subir o Caddy
#    (senão SSL automático do Let's Encrypt vai falhar).

IURIA_SCRAPER_TOKEN=GERE_COM_OPENSSL_RAND_HEX_32
DOMAIN=scraper.iuria.com.br
