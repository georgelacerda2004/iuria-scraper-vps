# ===== WhatsApp Cloud API (Meta) — o George gera no Meta for Developers =====
WHATSAPP_TOKEN=            # token permanente do usuário do sistema
PHONE_NUMBER_ID=           # "ID do número de telefone" na tela Configuração da API
WABA_ID=                   # "ID da conta do WhatsApp Business"
META_APP_SECRET=           # App → Configurações → Básico → Chave secreta do aplicativo
WEBHOOK_VERIFY_TOKEN=      # qualquer string longa; a mesma vai no painel do app em "Verificar token"

# ===== Supabase do IURIA (projeto juridicopro) =====
SUPABASE_URL=https://mvlhkyqsywqhlrqrdeje.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # a mesma chave que as edge functions usam

# ===== IA (Claude) =====
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5   # padrão; troque só se quiser outro modelo
CLAUDE_FALLBACKS=on            # "off" desliga o fallback automático em caso de recusa do modelo
NOME_ROBO=Paula
NOME_ESCRITORIO=o escritório

# ===== Escritório e advogado (vão nos PDFs e no cadastro) =====
ESCRITORIO_ID=                 # uuid do escritório no IURIA (tabela escritorios)
ADVOGADO_NOME=
ADVOGADO_OAB=                  # ex.: OAB/SP nº 000.000
RESPONSAVEL_NOME=              # quem acompanha o caso no IURIA (campo responsavel do processo); vazio = o advogado
ADVOGADO_NACIONALIDADE=brasileiro
ESCRITORIO_ENDERECO=
FORO_CONTRATO=São Paulo/SP
TRIBUNAL_PADRAO=TJSP
HONORARIOS_ENTRADA=500
HONORARIOS_RESTANTE_TEXTO=     # frase da cláusula de honorários sobre o saldo (vazio = aditivo por escrito depois da análise)

# ===== Asaas (cobrança da entrada) =====
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3   # produção: https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=           # o mesmo token cadastrado no webhook do Asaas (URL: /webhooks/asaas)

# ===== Aviso ao advogado (Telegram, opcional) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Petição (gerar-inicial) =====
# Custo por petição (17/10/2026): haiku ~US$0,02 | sonnet ~US$0,12 | opus ~US$0,37.
PETICAO_MODELO=sonnet          # haiku | sonnet | opus (modelos aceitos pela edge gerar-inicial)
PETICAO_MODELO_RAPIDO=haiku    # modelo das retentativas (2ª e 3ª tentativa)
# Travas anti-loop (incidente de 15-17/10: 1.261 iniciais para 2 clientes, US$ 463).
PETICOES_POR_CICLO=3           # máximo de petições geradas por rodada (a cada 15 min)
PETICOES_POR_CLIENTE_24H=2     # máximo de rascunhos por cliente em 24 h
PETICOES_TETO_24H=25           # teto global: acima disso o robô para e só loga
SISTEMA_PADRAO=eproc           # sistema do tribunal na distribuição (TJSP migrou para eproc)

# ===== Robô de campanha (Meta Marketing API) =====
META_ADS_TOKEN=                # token de usuário do sistema com ads_management + ads_read
META_AD_ACCOUNT_ID=248232860934925   # conta "Henrique Lacerda" (sem o prefixo act_)
META_PAGE_ID=                  # página que assina os anúncios (ligada ao número do WhatsApp)
CAMPANHA_ORCAMENTO_DIA=100
CAMPANHA_GASTO_MINIMO=60
CAMPANHA_TETO_CONVERSA=25
CAMPANHA_TETO_QUALIFICADO=120
CAMPANHA_JANELA_DIAS=7
CAMPANHA_AUTOPAUSAR=off        # "on" deixa o robô pausar anúncio sozinho; "off" só recomenda no relatório

# ===== Operação =====
PORT=10000
OPERADOR_WHATSAPP=         # número do George (55DDDNÚMERO) para avisos e handoff
